{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deckdna/schemas/evidence-graph.schema.json",
  "title": "EvidenceGraph",
  "type": "object",
  "required": ["schema_version", "id", "content_pack_id", "nodes", "edges"],
  "properties": {
    "schema_version": { "type": "string" },
    "id": { "type": "string" },
    "content_pack_id": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "source_ref"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["claim", "number", "entity", "section", "table", "visual", "source_span"]
          },
          "text": { "type": "string" },
          "value": {
            "type": "object",
            "properties": {
              "raw": { "type": "string" },
              "numeric": { "type": "number" },
              "unit": { "type": "string" }
            }
          },
          "source_ref": {
            "type": "object",
            "required": ["artifact_id"],
            "properties": {
              "artifact_id": { "type": "string" },
              "page": { "type": "integer" },
              "sheet": { "type": "string" },
              "range": { "type": "string" }
            }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "type"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["supports", "derived_from", "illustrates", "contrasts", "belongs_to"]
          },
          "weight": { "type": "number" }
        }
      }
    }
  }
}
