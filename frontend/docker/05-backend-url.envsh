#!/bin/sh
# Normalizes BACKEND_URL before the templates are rendered: default value, no trailing slash.
BACKEND_URL="${BACKEND_URL:-http://api:8000}"
while [ "${BACKEND_URL%/}" != "$BACKEND_URL" ]; do
    BACKEND_URL="${BACKEND_URL%/}"
done
case "$BACKEND_URL" in
    http://*/*|https://*/*|http://|https://)
        echo "05-backend-url: BACKEND_URL must be scheme://host[:port] without a path (got '$BACKEND_URL')" >&2; exit 1 ;;
    http://*|https://*) ;;
    *) echo "05-backend-url: BACKEND_URL must start with http:// or https:// (got '$BACKEND_URL')" >&2; exit 1 ;;
esac
export BACKEND_URL
