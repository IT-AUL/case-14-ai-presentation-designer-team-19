# DeckDNA environment — copy to .env only if you need non-defaults.
# docker compose up --build works WITHOUT .env (deterministic mock mode).

# --- Prebuilt release images ---
# Pull published images instead of building from source:
#   DECKDNA_VERSION=v1.1.0 docker compose up -d --no-build --pull always
# GHCR is the default registry; use docker.io/renatgubaudullin for Docker Hub.
# DECKDNA_REGISTRY=ghcr.io/it-aul
# DECKDNA_VERSION=dev

# --- Ports (host bindings are loopback-only) ---
# WEB_PORT=8080
# API_PORT=8000

# --- Upload limit ---
# DECKDNA_MAX_UPLOAD_MB=200

# --- Web research (opt-in; SearXNG URL or ddg:// for DuckDuckGo) ---
# DECKDNA_RESEARCH_SEARCH_URL=ddg://

# --- Model provider (opt-in; offline MockProvider by default) ---
# Any OpenAI-compatible endpoint serving open-weight models
# (Apache-2.0/MIT, ≤35B per task rules) works: vLLM, Ollama, TGI, VK Inference, etc.
# An explicit provider session chosen in the UI overrides these values.
# DECKDNA_MOCK_PROVIDER=false
# DECKDNA_PROVIDER_BASE_URL=http://your-endpoint:8000/v1
# DECKDNA_PROVIDER_API_KEY=
# DECKDNA_PROVIDER_PROJECT_ID=
# DECKDNA_MODEL_TEXT=
# DECKDNA_MODEL_VISION=
# DECKDNA_MODEL_EMBED=
# DECKDNA_MODEL_IMAGE=

# --- Provider tuning (only with a real provider) ---
# DECKDNA_PROVIDER_MAX_RETRIES=2
# DECKDNA_PROVIDER_EXTRA_BODY={"provider":{"sort":"throughput"}}
# DECKDNA_PROVIDER_CHAT_OPTIONS={"temperature":0.7}
# Allow http:// or private-network endpoints — operator-only, never
# accepted from a provider-session API request:
# DECKDNA_PROVIDER_ALLOW_PRIVATE_NETWORKS=false

# --- Fallback & Image Providers (optional) ---
# DECKDNA_FALLBACK_PROVIDER_BASE_URL=
# DECKDNA_FALLBACK_PROVIDER_API_KEY=
# DECKDNA_FALLBACK_MODEL_TEXT=qwen-3.8-27b
# DECKDNA_FALLBACK_MODEL_VISION=qwen-3.8-27b
# DECKDNA_IMAGE_BASE_URL=
# DECKDNA_IMAGE_API_KEY=
# DECKDNA_MODEL_IMAGE=black-forest-labs/flux.2-klein-4b
